# Copy to .env and fill in the values: cp .env.example .env

# ---- API server ----
PORT=3000
NODE_ENV=development
# Redis (required). Locally: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Install tokens (required): comma-separated kid:secret pairs. The first one signs new tokens;
# the rest are still accepted (key rotation). Secrets must be >= 32 chars. Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('hex'))"
INSTALL_TOKEN_KEYS=k1:replace-with-a-random-secret-of-at-least-32-characters

# Allowed extension IDs for Origin checks (comma-separated; required in production)
EXTENSION_IDS=

# ---- LLM (optional) ----
# From https://console.anthropic.com. Without it, summaries fall back to simple bullets and
# typed refinements are turned off.
ANTHROPIC_API_KEY=
# Daily LLM spend cap in USD (global, all installs)
LLM_DAILY_SPEND_CAP_USD=20
# Max concurrent LLM calls across all instances
LLM_MAX_CONCURRENCY=20

# ---- Search providers ----
# "fixture" replays recorded sample data and needs no keys.
# "live" makes every provider live and ignores the per-provider modes below.
PROVIDER_MODE=fixture
# Per-provider modes ("fixture" or "live"), used only when PROVIDER_MODE=fixture.
FLIGHTS_MODE=fixture
HOTELS_MODE=fixture
ACTIVITIES_MODE=fixture
# Needed when flights or hotels are live. A duffel_test_... token works.
# Hotel search (Duffel Stays) must be enabled on the Duffel account.
DUFFEL_ACCESS_TOKEN=
# Needed when activities are live (Viator Partner API).
VIATOR_API_KEY=
# Requests per second per provider, shared across instances
DUFFEL_RATE_PER_SEC=5
VIATOR_RATE_PER_SEC=10

# ---- Tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travellite

# ---- Live tests (cost money; off by default) ----
LIVE_LLM_TESTS=0
