# ---- API server ----
PORT=3000
NODE_ENV=development
# Redis (required). Locally: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Install tokens: comma-separated kid:secret pairs. The first one signs new tokens;
# the rest are still accepted (key rotation). Secrets must be >= 32 chars.
INSTALL_TOKEN_KEYS=k1:replace-with-a-random-secret-of-at-least-32-chars

# Allowed extension IDs for Origin checks (comma-separated)
EXTENSION_IDS=

# ---- LLM ----
ANTHROPIC_API_KEY=
# Daily LLM spend cap in USD (global, all installs)
LLM_DAILY_SPEND_CAP_USD=20
# Max concurrent LLM calls across all instances
LLM_MAX_CONCURRENCY=20

# ---- Search providers ----
# "fixture" replays fixtures/ and needs no credentials; "live" calls Duffel and Viator
PROVIDER_MODE=fixture
DUFFEL_ACCESS_TOKEN=
VIATOR_API_KEY=
# Requests per second per provider, shared across instances
DUFFEL_RATE_PER_SEC=5
VIATOR_RATE_PER_SEC=10

# ---- Tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travellite

# ---- Live tests (cost money; off by default) ----
LIVE_LLM_TESTS=0
